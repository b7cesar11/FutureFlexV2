# Future Flex V2 — backend environment
# Copy to backend/.env and replace values. Never commit real secrets.

APP_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=futureflex
JWT_SECRET=change-this-to-a-long-random-secret-with-at-least-32-characters
PROJECTION_WINDOW_MONTHS=24
REQUIRE_REPLICA_SET=true

# Auth cookies
# Local HTTP development: false + lax
# HTTPS production: true + lax (same-site) or true + none (cross-site only when needed)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend destination after OAuth login.
FRONTEND_URL=http://localhost:3000

# CORS — leave empty for same-origin frontend/backend.
# For split deployments use a comma-separated allow-list, never * in production.
CORS_ORIGINS=

# Demo data is opt-in and must remain false in production.
ENABLE_DEMO_USER=false

# Native Google OAuth (optional). Create a Web Application OAuth client in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# AI — official OpenAI API
OPENAI_API_KEY=
AI_MODEL=gpt-5.5
AI_DAILY_LIMIT=60
